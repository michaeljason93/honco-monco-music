---
interface PanelItem {
  heading?: string;
  body: string;
  img?: string; // optional image URL
}

interface Props {
  title?: string;
  items: PanelItem[];
}

const { title, items = [] } = Astro.props as Props;
---

<section class="three-cards py-5">
  <div class="container">
    {title ? <div class="row mb-4"><div class="col-12 text-center"><h2 class="u-font-heading">{title}</h2></div></div> : null}

    <div class="row">
      {items.map(item => (
        <div class="col-12 col-md-4 mb-4">
          <div class="card h-100 bg-white rounded-3 shadow-sm border-2">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                {item.heading ? <h3 class="card-title u-font-accent text-center mb-3 font-navy u-font-body text-uppercase">{item.heading}</h3> : null}
                <div class="card-text text-center u-font-body" set:html={item.body}></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
