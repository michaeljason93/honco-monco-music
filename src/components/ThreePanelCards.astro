---
interface PanelItem {
  heading?: string;
  body: string;
}

interface Props {
  title?: string;
  items: PanelItem[];
}

const { title, items = [] } = Astro.props as Props;
---
<section class="py-5">
  <div class="container">
    {title && (
      <div class="row mb-4">
        <div class="col-12 text-center"><h2 class="font-heading">{title}</h2></div>
      </div>
    )}

    <div class="row">
      {items.map((item) => (
        <div class="col-12 col-md-4 mb-4">
          <div class="card h-100 bg-white rounded-4 border border-2 border-dark shadow-sm">
            <div class="card-body text-center p-4">
              {item.heading && (
                <h3 class="card-title font-accent text-uppercase fs-5 text-navy mb-3">{item.heading}</h3>
              )}
              <div class="card-text font-body" set:html={item.body}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
