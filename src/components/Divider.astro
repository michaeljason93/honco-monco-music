---
interface Props {
  title: string;
  theme?: 'navy' | 'blue' | 'purple' | 'coral' | 'peach' | 'cream' | 'yellow' | 'pink' | 'green';
}

const { title, theme = 'blue' } = Astro.props as Props;
---
<section class={`bg-${theme} py-3`}>
  <div class="container text-center">
    <h1 class="text-uppercase" set:html={title}></h1>
  </div>
</section>
