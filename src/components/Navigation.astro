---
interface Props {
  current?: string;
}

const { current = '' } = Astro.props;
const links = [
  { href: '/', label: 'HOME', key: 'home' },
  { href: '/book-a-class', label: 'CLASSES', key: 'book' },
  { href: '/about', label: 'FAQs', key: 'about' },
  { href: '/contact', label: 'CONTACT', key: 'contact' }
];
---
<nav class="navbar navbar-expand-lg site-nav bg-purple pt-3 pb-0" aria-label="Main navigation">
  <div class="container-fluid px-0">
    <ul class="nav nav-tabs border-0 w-100 flex-row flex-wrap justify-content-center align-items-end gap-0 gap-lg-2">
      {links.map((link) => (
        <li class="nav-item">
          <a
            class:list={['nav-link', 'border-0', 'rounded-top-4', { active: current === link.key }]}
            href={link.href}
            aria-current={current === link.key ? 'page' : undefined}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
