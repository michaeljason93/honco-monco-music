---
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import TestimonialGallery from '../components/TestimonialGallery.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Get in Touch | Honco Monco Music" description="Contact Honco Monco Music.">
  <Navigation current="contact" />
  <main>
    <section class="section bg-cream pb-0 pt-5">
      <div class="container">
        <div class="row g-5">
          <div class="col-lg-6">
            <h2>Let's get in touch</h2>
            <p class="prose fs-5 mt-3">
              Do you have any questions about classes, availability or anything else? Please complete the
              form below and we will be in touch with you soon.
            </p>

            <div class="bg-blue rounded-4 p-4 mt-4">
              <form action="https://api.web3forms.com/submit" method="POST">
                <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
                <input type="hidden" name="subject" value="New Honco Monco Music enquiry" />
                <input type="hidden" name="from_name" value="Honco Monco Music website" />
                <input type="checkbox" name="botcheck" class="d-none" tabindex="-1" autocomplete="off" />

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="name">Your name</label>
                  <input class="form-control" id="name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="email">Email address</label>
                  <input class="form-control" id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="phone">Phone number</label>
                  <input class="form-control" id="phone" name="phone" type="tel" placeholder="Your phone number" autocomplete="tel" />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="child-first-name">Child&rsquo;s first name</label>
                  <input class="form-control" id="child-first-name" name="child_first_name" type="text" placeholder="Child&rsquo;s first name" autocomplete="off" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="child-age">Child&rsquo;s age</label>
                  <input class="form-control" id="child-age" name="child_age" type="text" placeholder="Child&rsquo;s age" inputmode="numeric" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold" for="message">How can we help?</label>
                  <textarea class="form-control" id="message" name="message" rows="5" placeholder="Tell us a little more..."></textarea>
                </div>

                <div class="h-captcha d-flex justify-content-center w-100" data-captcha="true"></div>
                <button class="btn w-100 w-lg-auto mt-3" type="submit">Send enquiry</button>
              </form>
            </div>
          </div>

          <div class="col-lg-5 offset-lg-1 mt-4">
            <div class="bg-navy text-white rounded-4 p-4">
              <p class="eyebrow text-cream">Prefer a quick hello?</p>
              <h3 class="fs-2 lh-1">Contact directly</h3>
              <a class="contact-email text-cream fs-6 d-block text-break" href="mailto:honcomoncomusic@gmail.com">honcomoncomusic@gmail.com</a>
              <a class="text-blue d-block mt-2 text-decoration-none" href="tel:07533982696">07533982696</a>
              <hr class="my-4" />
              <h3 class="fs-2 lh-1">Book a class</h3>
              <p>Find upcoming sessions and reserve a taster through our booking page.</p>
              <a class="btn w-100 w-lg-auto" href="/book-a-class">Book a class</a>
            </div>
            <div class="photo-placeholder bg-peach text-navy d-flex align-items-center justify-content-center text-center fw-semibold rounded-4 p-4 mt-4">
              Photo placeholder
            </div>
          </div>
        </div>
      </div>
    </section>

    <TestimonialGallery />
  </main>
  <Footer />
</Layout>

<script src="https://web3forms.com/client/script.js" async defer is:inline></script>
