---
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialGallery from '../components/TestimonialGallery.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="About | Honco Monco Music" description="Learn about Honco Monco Music and teacher Rhian.">
  <Navigation current="about" />
  <main>
    <PageHero theme="peach" eyebrow="A little bit of magic" title={'What should I expect<br />from a <span>Honco Monco</span><br />music class?'} intro="A playful, welcoming hour where little ones can explore music at their own pace." />
    <section class="page-content-section">
      <div class="container">
        <div class="row g-5">
          <div class="col-lg-7">
            <p class="eyebrow eyebrow-dark">The story so far</p>
            <h2>Made for curious<br /><em>little minds.</em></h2>
            <div class="placeholder-copy">
              <p>[Placeholder paragraph about how the classes came about, why mixed ages are important and the role of play and creativity.]</p>
              <p>[Placeholder paragraph about songs, musical play, building a musical brain and growing new neuropathways.]</p>
            </div>
          </div>
          <div class="col-lg-5"><div class="photo-placeholder photo-placeholder-blue">Class photo placeholder</div></div>
        </div>
        <div class="quote-card"><span>“</span><blockquote>“The important thing is not to stop questioning. Curiosity has its own reason for existing.”</blockquote><cite>— Albert Einstein</cite></div>
      </div>
    </section>
    <section class="about-section">
      <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">       
                <img class="teacher-photo rounded-5" src="/images/Rhian_sitting.webp" alt="Rhian sitting" />    
            </div>
            <div class="col-lg-7">
                <p class="eyebrow">About Rhian</p>
                <h2>Meet the person<br /><span>behind the music.</span></h2>
                <p class="about-copy mt-4">[Placeholder bio about Rhian’s experience, musical background and what she loves about making music with children and grown-ups.]</p>
            </div>
        </div>
    </div>
    </section>
    <TestimonialGallery />
  </main>
  <Footer />
</Layout>