---
import Layout from '../components/Layout.astro';
import Navigation from '../components/Navigation.astro';
import TeacherSection from '../components/TeacherSection.astro';
import Venue from '../components/Venue.astro';
import ContactSection from '../components/ContactSection.astro';
import TestimonialGallery from '../components/TestimonialGallery.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Honco Monco Music | Sing, move, play" description="Honco Monco Music: joyful, inclusive music classes for children aged 0-6 and their grown-ups.">
  <Navigation />
  <main id="top">
    <section class="hero-section">
      <div class="container hero-content">
        <div class="row align-items-center g-5 text-center">
          <div class="col-12">
            <!-- <p class="eyebrow">Croeso i Honco Monco Music</p> -->
            <h1>Croeso i <br/><span>Honco Monco Music</span></h1>
            <p class="hero-lede mx-auto">A fun, inclusive music class for children aged 0-6 and their grown-ups.</p>
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 hero-actions">
              <a class="btn btn-yellow btn-lg w-100 w-lg-auto" href="/book-a-class">Book your taster session</a>
            </div>
          </div>
        </div>
      </div>
    </section>
 
    <TeacherSection />
    <Venue />
    <TestimonialGallery />
    <ContactSection />
  </main>
  <Footer />
</Layout>